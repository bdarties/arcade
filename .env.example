# Copiez ce fichier en .env et ajustez les valeurs pour votre environnement local.
# .env n'est pas versionné (voir .gitignore).

# Active le mode debug Flask (rechargement auto, débogueur interactif).
# Mettre à 0/false en production ou sur une machine exposée au réseau.
FLASK_DEBUG=1

# Interface et port d'écoute du serveur de développement (run.py).
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000

# Emplacement du fichier SQLite des scores. Par défaut : scores.db à la racine du projet.
# DB_PATH=/chemin/vers/scores.db

# Jeton requis (header "X-Init-Token") pour appeler POST /init-db.
# Laisser vide désactive complètement la route.
INIT_DB_TOKEN=change-me

# Utilise static/js/score_fake.js (scores simulés) au lieu de static/js/score.js.
USE_FAKE_SCORES=0
